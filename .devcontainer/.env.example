# Copy this file to .env (gitignored — never commit the real values).

# Fine-grained GitHub PAT scoped to only the repo(s) this agent may touch
# (Contents, Issues, Pull requests: read/write; Metadata: read). The container
# has no access to your host's gh/keychain login, so this is the only
# credential it can ever use.
GH_TOKEN=github_pat_xxx

# Commit identity used inside the container, kept separate from your personal
# host git identity so agent commits are clearly attributable.
GIT_AUTHOR_NAME=claude-agent
GIT_AUTHOR_EMAIL=olireasu+agent@gmail.com
GIT_COMMITTER_NAME=claude-agent
GIT_COMMITTER_EMAIL=olireasu+agent@gmail.com

# owner/repo the agent is scoped to — informational, shown by postCreate.
TARGET_GITHUB_REPO=OlirEswar/your-repo-name

# Optional. Leave unset if you want to use your claude.ai subscription instead
# of pay-per-token API billing — in that case, run `claude login` inside the
# container the first time (it gives you a URL to open in any browser; the
# container itself doesn't need one), and the session persists via the
# claude-config volume in docker-compose.yml. Set this only if you
# specifically want API-key billing instead of the subscription.
ANTHROPIC_API_KEY=sk-ant-xxx
